# Copy to .env for local overrides. Never commit .env.

KNOWLEDGEPILOT_HOST=127.0.0.1
KNOWLEDGEPILOT_PORT=8000
KNOWLEDGEPILOT_DATA_DIR=./data
KNOWLEDGEPILOT_OFFLINE_MODE=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Optional: protect /orchestrate and /automations/* (Bearer token). Leave unset for local-only trust.
# KNOWLEDGEPILOT_API_KEY=

# Ingest watcher (ingest_watcher agent + optional schedule)
# KNOWLEDGEPILOT_WATCH_ENABLED=true
# KNOWLEDGEPILOT_WATCH_FOLDER=./samples/demo_corpus
# KNOWLEDGEPILOT_WATCH_FOLDERS=./samples/demo_corpus,./exports/confluence

# KNOWLEDGEPILOT_NOTIFY_WEBHOOK_URL=https://hooks.example.com/...
# KNOWLEDGEPILOT_WATCH_RECURSIVE=true
# KNOWLEDGEPILOT_WATCH_TAGS=watched,auto-ingest

# --- Optional: Confluence Cloud sync (see docs/CONFLUENCE_PAT.md) ---
# KNOWLEDGEPILOT_CONFLUENCE_ENABLED=true
# KNOWLEDGEPILOT_CONFLUENCE_BASE_URL=https://your-site.atlassian.net/wiki
# KNOWLEDGEPILOT_CONFLUENCE_EMAIL=you@company.com
# KNOWLEDGEPILOT_CONFLUENCE_API_TOKEN=
# KNOWLEDGEPILOT_CONFLUENCE_AUTH_MODE=bearer
# KNOWLEDGEPILOT_CONFLUENCE_VERIFY_SSL=true
